{
  "name": "SAD Mobile — ASYCUDA SAD Generator",
  "short_name": "SAD Mobile",
  "description": "Generate ASYCUDA SAD import files on your phone. Works offline; files never leave your device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F6F7FB",
